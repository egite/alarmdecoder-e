+    def _throttle(self, type):
+        """
+        Returns (allowed, dropped) where dropped is the number of messages
+        discarded since the last one that was allowed through.
+        """
+        # Test messages and life-safety events are never held back, but they
+        # still count toward the limit.
+        exempt = type is None or type in THROTTLE_EXEMPT_EVENTS
+
+        if self.throttle_count <= 0 or self.throttle_minutes <= 0:
+            return True, 0
+
+        with self._throttle_lock:
+            now = time.time()
+            window_start = now - self.throttle_minutes * 60
+            while self._throttle_sent and self._throttle_sent[0] <= window_start:
+                self._throttle_sent.popleft()
+
+            if not exempt and len(self._throttle_sent) >= self.throttle_count:
+                self._throttle_dropped += 1
+                return False, self._throttle_dropped
+
+            self._throttle_sent.append(now)
+            dropped = self._throttle_dropped
+            self._throttle_dropped = 0
+
+            return True, dropped
